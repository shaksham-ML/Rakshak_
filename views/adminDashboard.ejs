<% layout("./layouts/boilerplate") %>

<head>
    <link
        rel="stylesheet"
        href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css"
    />
</head>

<div class="container">

    <h1>Rakshak Control Center</h1>

    <!-- ================= STATS ================= -->

    <div class="stats">

        <div class="card">
            <h3>Total Incidents</h3>
            <p id="totalIncidents">0</p>
        </div>

        <div class="card">
            <h3>Critical Incidents</h3>
            <p id="criticalIncidents">0</p>
        </div>

        <div class="card">
            <h3>Active Incidents</h3>
            <p id="activeIncidents">0</p>
        </div>

        <div class="card">
            <h3>Available Teams</h3>
            <p id="availableTeams">0</p>
        </div>

    </div>

    <hr>

    <!-- ================= MAP ================= -->

    <h2>Disaster Map</h2>

    <div id="map"></div>

    <div class="map-legend">
        <strong>Map Legend</strong>
        <span>🔴 Incident</span>
        <span>🟢 Available Team</span>
        <span>🟠 Busy Team</span>
    </div>

    <hr>

    <!-- ================= INCIDENTS ================= -->

    <h2>Incidents</h2>

    <div id="incidentList"></div>

    <hr>

    <!-- ================= TEAMS ================= -->

    <h2>Teams</h2>

    <div id="teamList"></div>

    <hr>

    <!-- ================= ASSIGNMENT HISTORY ================= -->

    <h2>Assignment History</h2>

    <div id="assignmentList">
        Loading assignment history...
    </div>

</div>


<!-- ================================================= -->
<!-- LEAFLET JS - MAP CODE SE PEHLE LOAD HONA CHAHIYE -->
<!-- ================================================= -->

<script src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js"></script>


<script>

/* =====================================================
   1. MAP INITIALIZATION
===================================================== */

const map = L.map("map").setView([26.4499, 80.3319], 10);

const markerLayer = L.layerGroup().addTo(map);

L.tileLayer(
    "https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png",
    {
        attribution: "&copy; OpenStreetMap contributors"
    }
).addTo(map);


/* =====================================================
   2. SHOW TEAM ROUTE
===================================================== */

function showTeamRoute(incident, team) {

    if (
        !incident ||
        !team ||
        incident.latitude == null ||
        incident.longitude == null ||
        team.latitude == null ||
        team.longitude == null
    ) {
        return;
    }

    const routeLine = L.polyline(
        [
            [team.latitude, team.longitude],
            [incident.latitude, incident.longitude]
        ],
        {
            weight: 4
        }
    ).addTo(markerLayer);

    routeLine.bindPopup(`
        <strong>${team.name}</strong><br>
        Response route to ${incident.type}
    `);
}


/* =====================================================
   3. ADD MARKERS TO MAP
===================================================== */

function addMarkers(data) {

    markerLayer.clearLayers();


    /* ================= INCIDENT MARKERS ================= */

    data.incidents.forEach(incident => {

        if (
            incident.latitude == null ||
            incident.longitude == null
        ) {
            return;
        }

        const incidentIcon = L.divIcon({
            className: "incident-marker",
            html: "🔴",
            iconSize: [30, 30],
            iconAnchor: [15, 15]
        });

        const marker = L.marker(
            [
                incident.latitude,
                incident.longitude
            ],
            {
                icon: incidentIcon
            }
        ).addTo(markerLayer);

        marker.bindPopup(`
            <h3>${incident.type}</h3>

            <p>
                <strong>Priority:</strong>
                ${incident.priority}
            </p>

            <p>
                <strong>People affected:</strong>
                ${incident.peopleAffected}
            </p>

            <p>
                <strong>Medical emergencies:</strong>
                ${incident.medicalEmergency}
            </p>

            <p>
                <strong>Status:</strong>
                ${incident.status}
            </p>
        `);

    });


    /* ================= TEAM MARKERS ================= */

    data.teams.forEach(team => {

        if (
            team.latitude == null ||
            team.longitude == null
        ) {
            return;
        }

        let iconEmoji = "🟢";

        if (team.status === "BUSY") {
            iconEmoji = "🟠";
        }

        const teamIcon = L.divIcon({
            className: "team-marker",
            html: iconEmoji,
            iconSize: [30, 30],
            iconAnchor: [15, 15]
        });

        const marker = L.marker(
            [
                team.latitude,
                team.longitude
            ],
            {
                icon: teamIcon
            }
        ).addTo(markerLayer);

        marker.bindPopup(`
            <h3>${team.name}</h3>

            <p>
                <strong>Status:</strong>
                ${team.status}
            </p>

            <p>
                <strong>Capacity:</strong>
                ${team.capacity}
            </p>

            <p>
                <strong>Capabilities:</strong>
                ${team.capabilities.join(", ")}
            </p>
        `);

    });


    /* ================= TEAM → INCIDENT ROUTE ================= */

    data.teams.forEach(team => {

        if (
            team.status === "BUSY" &&
            team.assignedIncident
        ) {

            showTeamRoute(
                team.assignedIncident,
                team
            );

        }

    });

}


/* =====================================================
   4. LOAD ADMIN DASHBOARD
===================================================== */

async function loadDashboard() {

    try {

        const response =
            await fetch("/api/admin/dashboard");

        if (!response.ok) {
            throw new Error("Dashboard data load nahi hua");
        }

        const data =
            await response.json();


        /* ================= STATISTICS ================= */

        document.getElementById("totalIncidents").textContent =
            data.statistics.totalIncidents;

        document.getElementById("criticalIncidents").textContent =
            data.statistics.criticalIncidents;

        document.getElementById("activeIncidents").textContent =
            data.statistics.activeIncidents;

        document.getElementById("availableTeams").textContent =
            data.statistics.availableTeams;


        /* ================= MAP ================= */

        addMarkers(data);


        /* ================= INCIDENTS ================= */

        const incidentList =
            document.getElementById("incidentList");

        incidentList.innerHTML = "";

        if (data.incidents.length === 0) {

            incidentList.innerHTML =
                "<p>No incidents found.</p>";

        } else {

            data.incidents.forEach(incident => {

                const incidentCard =
                    document.createElement("div");

                incidentCard.className =
                    "incident-card";

                incidentCard.innerHTML = `

                    <h3>
                        ${incident.type}
                    </h3>

                    <p>
                        Priority:
                        ${incident.priority}
                    </p>

                    <p>
                        People affected:
                        ${incident.peopleAffected}
                    </p>

                    <p>
                        Medical emergencies:
                        ${incident.medicalEmergency}
                    </p>

                    <p>
                        Status:
                        ${incident.status}
                    </p>

                    <button
                        onclick="allocateTeam('${incident._id}')"
                    >
                        Allocate Team
                    </button>

                    <div
                        id="recommendation-${incident._id}"
                    ></div>

                    <hr>
                `;

                incidentList.appendChild(incidentCard);

            });

        }


        /* ================= TEAMS ================= */

        const teamList =
            document.getElementById("teamList");

        teamList.innerHTML = "";

        if (data.teams.length === 0) {

            teamList.innerHTML =
                "<p>No teams found.</p>";

        } else {

            data.teams.forEach(team => {

                const teamCard =
                    document.createElement("div");

                teamCard.className =
                    "team-card";

                teamCard.innerHTML = `

                    <h3>
                        ${team.name || "Unnamed Team"}
                    </h3>

                    <p>
                        <strong>Status:</strong>
                        ${team.status}
                    </p>
                `;

                teamList.appendChild(teamCard);

            });

        }

    } catch (error) {

        console.error(error);

        document.getElementById("incidentList").innerHTML =
            "<p>Failed to load dashboard data.</p>";
    }
}


/* =====================================================
   5. ALLOCATE TEAM
===================================================== */

async function allocateTeam(incidentId) {

    try {

        const response =
            await fetch("/api/allocate", {

                method: "POST",

                headers: {
                    "Content-Type": "application/json"
                },

                body: JSON.stringify({
                    incidentId: incidentId
                })

            });

        const data =
            await response.json();

        console.log(data);


        const recommendation =
            document.getElementById(
                `recommendation-${incidentId}`
            );


        if (data.recommendedTeam) {

            recommendation.innerHTML = `

                <div>

                    <h3>Recommended Team</h3>

                    <p>
                        Team:
                        ${data.recommendedTeam.teamName}
                    </p>

                    <p>
                        Distance:
                        ${data.recommendedTeam.distance} km
                    </p>

                    <p>
                        Capabilities:
                        ${data.recommendedTeam.capabilities.join(", ")}
                    </p>

                    <button
                        onclick="assignTeam(
                            '${incidentId}',
                            '${data.recommendedTeam.teamId}'
                        )"
                    >
                        ASSIGN THIS TEAM
                    </button>

                </div>

            `;

        } else {

            recommendation.innerHTML = `
                <p>${data.message}</p>
            `;

        }

    } catch (error) {

        console.log(error);

    }

}


/* =====================================================
   6. ASSIGN TEAM
===================================================== */

async function assignTeam(incidentId, teamId) {

    try {

        const response =
            await fetch("/api/assign", {

                method: "POST",

                headers: {
                    "Content-Type": "application/json"
                },

                body: JSON.stringify({
                    incidentId: incidentId,
                    teamId: teamId
                })

            });

        const data =
            await response.json();

        console.log(data);


        if (response.ok) {

            alert("Team successfully assigned!");

            loadDashboard();

        } else {

            alert(data.message);

        }

    } catch (error) {

        console.log(error);

        alert("Assignment failed");

    }

}


/* =====================================================
   7. ASSIGNMENT HISTORY
===================================================== */

async function loadAssignmentHistory() {

    try {

        const response =
            await fetch("/api/admin/assignments");

        const assignments =
            await response.json();

        const assignmentList =
            document.getElementById("assignmentList");

        assignmentList.innerHTML = "";


        if (assignments.length === 0) {

            assignmentList.innerHTML =
                "<p>No assignments yet.</p>";

            return;
        }


        assignments.forEach(assignment => {

            const incident =
                assignment.incidentId;

            const team =
                assignment.teamId;


            const div =
                document.createElement("div");

            div.className =
                "assignment-card";


            div.innerHTML = `

                <h3>
                    ${incident.type}
                </h3>

                <p>
                    <strong>Team:</strong>
                    ${team.name}
                </p>

                <p>
                    <strong>Incident Status:</strong>
                    ${incident.status}
                </p>

                <p>
                    <strong>Assignment Status:</strong>
                    ${assignment.status}
                </p>

                <p>
                    <strong>Assigned At:</strong>
                    ${new Date(
                        assignment.assignedAt
                    ).toLocaleString()}
                </p>

                <hr>

            `;

            assignmentList.appendChild(div);

        });

    } catch (error) {

        console.log(error);

        document.getElementById("assignmentList").innerHTML =
            "<p>Failed to load assignment history.</p>";

    }

}


/* =====================================================
   8. START DASHBOARD
===================================================== */

loadDashboard();
loadAssignmentHistory();

</script>


<style>

#map {

    height: 500px;
    width: 100%;

    margin-bottom: 30px;

}

.map-legend {

    display: flex;

    gap: 20px;

    margin: 10px 0 30px;

    padding: 10px;

    border: 1px solid #ddd;

}

.map-legend span {

    margin-left: 10px;

}

</style>