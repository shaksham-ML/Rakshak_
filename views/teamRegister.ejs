<% layout("./layouts/boilerplate") %>

<div class="container">
    <h1>Register Response Team</h1>

    <form method="post" action="/api/teams">

        <label for="name">Team Name</label>
        <input
            type="text"
            id="name"
            name="team[name]"
            placeholder="Enter team name"
            required
        >

        <br><br>

        <label>Capabilities</label>

        <div>
            <input
                type="checkbox"
                name="team[capabilities][]"
                value="RESCUE"
            >
            <label>Rescue</label>
        </div>

        <div>
            <input
                type="checkbox"
                name="team[capabilities][]"
                value="MEDICAL"
            >
            <label>Medical</label>
        </div>

        <div>
            <input
                type="checkbox"
                name="team[capabilities][]"
                value="FIRE"
            >
            <label>Fire</label>
        </div>

        <div>
            <input
                type="checkbox"
                name="team[capabilities][]"
                value="EVACUATION"
            >
            <label>Evacuation</label>
        </div>

        <br>

        <label for="capacity">Team Capacity</label>

        <input
            type="number"
            id="capacity"
            name="team[capacity]"
            min="1"
            placeholder="Number of people"
            required
        >

        <br><br>

        <label>Team Location</label>

        <div id="map" style="height:400px;"></div>

        <br>

        <label>Latitude</label>
        <input
            id="latitude"
            name="team[latitude]"
            type="number"
            step="any"
            readonly
            required
        >

        <br>

        <label>Longitude</label>
        <input
            id="longitude"
            name="team[longitude]"
            type="number"
            step="any"
            readonly
            required
        >

        <br><br>

        <button type="submit">
            Register Team
        </button>

    </form>
</div>